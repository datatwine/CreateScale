{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "django-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": ["manage.py", "runserver", "0.0.0.0:8000"],
      "port": 8000
    },
    {
      "name": "expo-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd createscale-app && npx expo start --web"],
      "port": 8082
    }
  ]
}
